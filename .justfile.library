# Recipes for a project that ships a pure-Python wheel, imported by the base .justfile.
#
# Copier renders only the name below. Everything inside the raw block uses just's
# own brace syntax, which must reach the generated file untouched.

_package := "libration"


[group('application')]
[doc('Set the project up: dependencies and hooks')]
@install: install-dependencies
    -prek install --hook-type pre-commit --hook-type commit-msg


[group('quality')]
[no-exit-message]
[doc('Run the test suite')]
[positional-arguments]
@test *args:
    uv run pytest "$@"


[group('quality')]
[doc('Lint and check formatting')]
@lint:
    uv run ruff check .
    uv run ruff format --check .


[group('quality')]
[doc('Type-check with ty — reports only; the exit code stays 0 until the library is clean')]
@types:
    -uvx ty check --python .venv


[group('maintenance')]
[doc('Build the wheel')]
@build:
    uv build


[group('maintenance')]
[doc('Install all dependencies: the extras and the dependency groups')]
@install-dependencies:
    uv sync --all-extras --all-groups


[group('maintenance')]
[doc('Mint a release on GitHub and wait for it: default, dev, rc, alpha, beta or post')]
release mode="default":
    #!/usr/bin/env bash
    set -euo pipefail
    gh workflow run package-release.yml --ref trunk --field mode={{ mode }}
    sleep 5
    gh run watch "$(gh run list --workflow package-release.yml --limit 1 --json databaseId --jq '.[0].databaseId')" --exit-status
    git pull --ff-only --tags origin trunk
    git describe --tags --abbrev=0


[group('maintenance')]
[doc('Upload a release tag to PyPI. It waits for a reviewer on GitHub, and an upload is final')]
publish tag:
    #!/usr/bin/env bash
    set -euo pipefail
    gh workflow run package-publish.yml --ref trunk --field tag={{ tag }}
    sleep 5
    gh run list --workflow package-publish.yml --limit 1 --json url --jq '.[0].url'
